  "rawData": {
   "htmlData": "\n<div class=\"lu-modal show lu-modal--lg\" id=\"confirmationModal\" namespace=\"ModulesGarden_HostingRenewals_App_UI_Client_ButtonsPanel_Modals_RenewServiceModal\" index=\"renewServiceModal\">\n    <div class=\"lu-modal__dialog\">\n        <div class=\"lu-modal__content\" id=\"mgModalContainer\">\n            <div class=\"lu-modal__top lu-top\">\n                <div class=\"lu-top__title lu-type-6\">\n                    <span class=\"lu-text-faded lu-font-weight-normal\">\n                        Продлить услугу на 1 месяц                    </span>\n                </div>\n                <div class=\"lu-top__toolbar\">\n                    <button class=\"lu-btn lu-btn--xs lu-btn--default lu-btn--icon lu-btn--link lu-btn--plain closeModal\" data-dismiss=\"lu-modal\" aria-label=\"Close\" @click='closeModal($event)'>\n                        <i class=\"lu-btn__icon lu-zmdi lu-zmdi-close\"></i>\n                    </button>\n                </div>\n            </div>\n            <div class=\"lu-modal__body\">\n                <div class=\"lu-row\">\n                    <div class=\"lu-col-md-12\">\n                                                    <div>\n            <mg-component-body-renewserviceform\n            component_id='renewServiceForm'\n            component_namespace='ModulesGarden_HostingRenewals_App_UI_Client_ButtonsPanel_Forms_RenewServiceForm'\n            component_index='renewServiceForm'\n    ></mg-component-body-renewserviceform>\n</div>\n                                            </div>\n                </div>\n            </div>\n            <div class=\"lu-modal__actions\">\n                                    \n<button class=\"lu-btn lu-btn--success submitForm mg-submit-form\"  @click=\"submitForm($event)\" >\n    Продлить\n</button>\n\n                                    \n<button class=\"lu-btn lu-btn--danger lu-btn--outline lu-btn--plain closeModal\"  @click=\"closeModal($event)\" >\n    Отменить\n</button>\n\n                 \n            </div>\n                    </div>\n    </div>\n</div>            ",
   "template": "\n\n<script type=\"text/x-template\" id=\"t-mg-renew-service-form-renewserviceform\"\n        :component_id=\"component_id\"\n        :component_namespace=\"component_namespace\"\n        :component_index=\"component_index\"\n>\n    <form id=\"renewServiceForm\" namespace=\"ModulesGarden_HostingRenewals_App_UI_Client_ButtonsPanel_Forms_RenewServiceForm\" index=\"renewServiceForm\" mgformtype=\"renew\"\n     onsubmit=\"return false;\" >\n\n    \n                                    <input type=\"hidden\" name=\"hostingID\" value=\"100001\"  @keyup.enter=\"submitFormByField($event)\"  />\n                            <input type=\"hidden\" name=\"months\" value=\"1\"  @keyup.enter=\"submitFormByField($event)\"  />\n                            <input type=\"hidden\" name=\"renewPrice\" value=\"\"  @keyup.enter=\"submitFormByField($event)\"  />\n                            <input type=\"hidden\" name=\"cycle\" value=\"monthly\"  @keyup.enter=\"submitFormByField($event)\"  />\n                            <div class=\"lu-widget\">\n                        <div class=\"lu-widget__body\">\n                <table class=\"lu-table\" width=\"100%\" role=\"grid\" >\n                    <tbody>\n                    <tr>\n                        <td><strong>Услуга:</strong></td>\n                        <td>Виртуальный сервер: Promo (Испания)</td>\n                        <td><strong>Действует до:</strong></td>\n                        <td>27.11.2026</td>\n                    </tr>\n                    <tr>\n                        <td><strong>Домен:</strong></td>\n                        <td>name-1</td>\n                        <td><strong>Срок действия после оплаты счета:</strong></td>\n                        <td v-html=\"newNextDueDate\"></td>\n                    </tr>\n\n                    </tbody>\n                </table>\n            </div>\n        </div>\n        \n        \n                \n                \n\n        \n\n                <div class=\"lu-widget\">\n            <div class=\"lu-widget__body\">\n                <div class=\"lu-row\">\n                    <div class=\"lu-col-md-8\">\n                        <label class=\"lu-form-label\">Промокод</label>\n                        <input\n                                type=\"text\"\n                                class=\"lu-form-control\"\n                                name=\"promoCode\"\n                                v-model=\"promoCode\"\n                                @keyup.enter.prevent=\"applyPromoCode()\"\n                                placeholder=\"Промокод\"\n                        >\n                    </div>\n                    <div class=\"lu-col-md-4\" style=\"padding-top: 28px;\">\n                        <button type=\"button\" class=\"lu-btn lu-btn--success\" @click=\"applyPromoCode()\">Применить</button>\n                    </div>\n                </div>\n                <div class=\"lu-row\" v-if=\"promoMessage\">\n                    <div class=\"lu-col-md-12\">\n                        <small :class=\"promoValid ? 'text-success' : 'text-danger'\" v-html=\"promoMessage\"></small>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n        <div class=\"lu-widget\">\n                        <div class=\"lu-widget__body\">\n                <div>\n                    <table class=\"lu-table\" width=\"100%\" role=\"grid\" >\n                        <tbody>\n                            <tr>\n                                <td><strong>Итого:</strong></td>\n                                <td v-html=\"subtotal\"></td>\n                                <td><strong>К оплате:</strong></td>\n                                <td v-html=\"total\"></td>\n                            </tr>\n                            <tr v-if=\"taxEnable || discountExists\">\n                                <td><strong v-if=\"taxEnable\" v-html=\"taxName\">НДС:</strong></td>\n                                <td v-html=\"tax\"></td>\n                                <td><strong v-if=\"discountExists\">Скидка:</strong></td>\n                                <td v-html=\"discount\"></td>\n                            </tr>\n                        </tbody>\n                    </table>\n                    <div class=\"lu-preloader-container lu-preloader-container--full-screen lu-preloader-container--overlay\" v-show=\"recalculatePrice\">\n                        <div class=\"lu-preloader lu-preloader--sm\"></div>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n            </form>\n</script>\n",
   "registrations": {
    "renewServiceForm": "mg-renew-service-form"
   }
  }
 }
