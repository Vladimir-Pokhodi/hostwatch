# Telegram bot token from @BotFather. Required.
BOT_TOKEN=
# Your numeric Telegram user ID. The bot ignores everyone else. Required.
OWNER_ID=
# 32-byte key in base64 that encrypts hoster credentials. Required.
# Generate: python -c "from hostwatch.core.secrets import generate_key; print(generate_key())"
HOSTWATCH_KEY=
# Public IP of this server. The login page gets a Let's Encrypt certificate for it,
# and the bot finds its own server among your servers by it. Empty: the bot asks api.ipify.org,
# but Caddy needs either this or HOSTWATCH_DOMAIN.
HOSTWATCH_IP=
# Domain for the login page. Empty means HOSTWATCH_IP is used.
HOSTWATCH_DOMAIN=
# Proxy for Telegram API, e.g. socks5://user:pass@host:port. Optional.
TG_PROXY=
# URL pinged every 5 minutes (e.g. healthchecks.io). Optional.
HEARTBEAT_URL=
# Where the database and backups (backups/, last 7 nights) live. Default: /data
DATA_DIR=
# Folder with your own plugins, one subfolder per plugin. Optional.
PLUGINS_DIR=
# Image tag to run, e.g. 1.0.0. Empty: the newest 1.x release.
HOSTWATCH_VERSION=
